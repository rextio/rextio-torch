.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
__pycache__/
build/
dist/
*.egg-info/
target/
native-e2e.xml
.rextio/
*.so
*.dylib
*.pyd
# Intermediate benchmark artifacts; keep authoritative full results trackable
# when they exist. Smoke runs write only to ignored/temp paths.
benchmarks/results/*
!benchmarks/results/latest.json
!benchmarks/results/report.md
!benchmarks/results/evidence/
!benchmarks/results/evidence/**
# Phase B has independent authoritative output ownership. Smoke or ad-hoc
# runs must use ignored paths outside this allow-list.
benchmarks/results_phase_b/*
!benchmarks/results_phase_b/latest.json
!benchmarks/results_phase_b/report.md
!benchmarks/results_phase_b/evidence/
!benchmarks/results_phase_b/evidence/**
